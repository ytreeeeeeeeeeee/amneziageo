<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <!-- Тесты подставляют свою платформу шрифтов Avalonia. -->
    <AvaloniaAccessUnstablePrivateApis>true</AvaloniaAccessUnstablePrivateApis>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.v3.mtp-off" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\amneziageo-android\AmneziaGeo.Android.Ui\Services\AndroidAgentConnection.cs" LogicalName="AndroidAgentConnection.cs" />
    <Compile Include="..\..\amneziageo-android\AmneziaGeo.Android.Ui\Services\LegacyRoutingSelection.cs" Link="LegacyRoutingSelection.cs" />
    <Compile Include="..\..\amneziageo-android\AmneziaGeo.Android.Ui\Services\VpnConnectPreparation.cs" Link="VpnConnectPreparation.cs" />
    <Compile Include="..\..\amneziageo-android\AmneziaGeo.Android.Engine\GeoRoutingPlan.cs" Link="GeoRoutingPlan.cs" />
    <Compile Include="..\..\amneziageo-android\AmneziaGeo.Android.Engine\DnsRouteHints.cs" Link="DnsRouteHints.cs" />
    <Compile Include="..\..\amneziageo-android\AmneziaGeo.Android.Engine\RouteBudget.cs" Link="RouteBudget.cs" />
    <Compile Include="..\..\amneziageo-android\AmneziaGeo.Android.Engine\VpnSessionFiles.cs" Link="VpnSessionFiles.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\amneziageo-lib\AmneziaGeo.Cli\AmneziaGeo.Cli.csproj" />
    <ProjectReference Include="..\..\amneziageo-lib\AmneziaGeo.Dal\AmneziaGeo.Dal.csproj" />
    <ProjectReference Include="..\..\amneziageo-lib\AmneziaGeo.Deltas\AmneziaGeo.Deltas.csproj" />
    <ProjectReference Include="..\..\amneziageo-lib\AmneziaGeo.Ui\AmneziaGeo.Ui.csproj" />
    <ProjectReference Include="..\..\amneziageo-windows\AmneziaGeo.Windows.App\AmneziaGeo.Windows.App.csproj" />
  </ItemGroup>

</Project>
